@model PucPocV1.ViewModels.RegisterViewModel
@using PucPocV1.Enums

@{
    ViewData["Title"] = "Cadastro";
}

<h1>Cadastro</h1>

@if (ViewBag.Mensagem != null)
{
    <p>@ViewBag.Mensagem</p>
}

<form asp-controller="Authenticate" asp-action="Registrar" method="post">
    <div>
        <label>Tipo de conta</label>
        <div>
            <input asp-for="NivelAcesso"
            type="radio"
            value="@PerfilEnum.Mentorado" />
            <label>Mentorado</label>
        </div>
        <div>
            <input asp-for="NivelAcesso"
                   type="radio"
                   value="@PerfilEnum.Mentor" />
            <label>Mentor</label>
        </div>
        <span asp-validation-for="NivelAcesso"></span>
    </div>
    <div>
        <label asp-for="Nome"></label>
        <input asp-for="Nome" />
        <span asp-validation-for="Nome"></span>
    </div>
    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>
    <div>
        <label asp-for="Senha"></label>
        <input asp-for="Senha" />
        <span asp-validation-for="Senha"></span>
    </div>
    <div>
        <label asp-for="ConfirmarSenha"></label>
        <input asp-for="ConfirmarSenha" />
        <span asp-validation-for="ConfirmarSenha"></span>
    </div>
    <div>
        <label asp-for="Data_Nasc"></label>
        <input asp-for="Data_Nasc" />
        <span asp-validation-for="Data_Nasc"></span>
    </div>
    <div>
        <label asp-for="Genero"></label>
        <input asp-for="Genero"  maxlength="1"/>
        <span asp-validation-for="Genero"></span>
    </div>
    <div>
        <label asp-for="Escolaridade"></label>
        <input asp-for="Escolaridade" maxlength="2" />
        <span asp-validation-for="Escolaridade"></span>
    </div>

  
    <button type="submit">Cadastrar</button>

    
</form>