@model PucPocV1.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<h1>Entrar</h1>

@if (ViewBag.Mensagem != null)
{
    <p>@ViewBag.Mensagem</p>
}


<form asp-controller="Authenticate"
      asp-action="Login"
      method="post">

      <div>
          <label asp-for="Email"></label>
          <input asp-for="Email" />
          <span asp-validation-for="Email"></span>
      </div>

      <div>
          <label asp-for="Senha"></label>
          <input asp-for="Senha" />
          <span asp-validation-for="Senha"></span>
      </div>

      <div asp-validation-summary="ModelOnly"></div>

      <button type="submit">
          Entrar
      </button>

</form>